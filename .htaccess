# Apache Server Configuration for MIHA Technologies
# Compliance Standard: security.md (Phase 0, Phase 6)

# 1. Clean URLs & Routing
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /YEAR%204/COMPANY%20WEBSITE/

    # Map /api/contact to api/contact.php
    RewriteRule ^api/contact/?$ api/contact.php [L]

    # If requested URI exists as file or directory, serve directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Map extensionless URLs in /solutions/
    RewriteCond %{DOCUMENT_ROOT}/YEAR\ 4/COMPANY\ WEBSITE/solutions/$1.html -f
    RewriteRule ^solutions/([^/]+)/?$ solutions/$1.html [L]

    # Map extensionless URLs to .html files
    RewriteCond %{DOCUMENT_ROOT}/YEAR\ 4/COMPANY\ WEBSITE/$1.html -f
    RewriteRule ^([^/]+)/?$ $1.html [L]

    # Map nested SPA routes to their parent page
    RewriteRule ^portfolio/.*$ portfolio.html [L]

    # Root redirect
    RewriteRule ^$ index.html [L]
</IfModule>

# 2. Attack Surface Defense & Sensitive File Blocking (security.md Phase 0)
<FilesMatch "^\.(env|git|htaccess|gitignore)|.*\.json$|.*\.(sql|db|sqlite|log|bak|conf|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

Options -Indexes

# 3. Security Headers (security.md Phase 6)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# 4. Proper MIME Types
<IfModule mod_mime.c>
    AddType text/css .css
    AddType application/javascript .js
    AddType image/svg+xml .svg
    AddType image/webp .webp
    AddType image/png .png
    AddType image/jpeg .jpg .jpeg
</IfModule>

# 5. Performance Caching
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/jpeg "access plus 1 month"
</IfModule>
